# The deploy is site/ only (see outputDirectory in vercel.json). Everything below is
# either source material for the asset pipeline or build tooling, and must not ship.
.git
.DS_Store
.env*
node_modules

# Asset pipeline inputs and tooling — the 56MB source model, the CI originals, the
# Blender scene and the headless verification scripts.
site/node_modules
site/build-src
site/tools

# The render pipeline: Blender scene, intermediate PNGs, the 20 MB HDRI. None of it is served
# — assets/film is the output that ships — and together it is ~470 MB, which is what was
# making deploys hang rather than fail.
site/render
site/package.json
site/package-lock.json
CI
Avatar
test

*.zip
